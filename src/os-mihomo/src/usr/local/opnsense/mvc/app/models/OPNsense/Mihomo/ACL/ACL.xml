<acl>
    <page-services-mihomo>
        <name>服务：Mihomo</name>
        <patterns>
            <pattern>ui/mihomo/*</pattern>
            <pattern>api/mihomo/*</pattern>
        </patterns>
    </page-services-mihomo>
    <page-services-mihomo-general>
        <name>服务：Mihomo：常规设置</name>
        <patterns>
            <pattern>ui/mihomo</pattern>
            <pattern>ui/mihomo/</pattern>
            <pattern>ui/mihomo/index*</pattern>
            <pattern>api/mihomo/general/*</pattern>
            <pattern>api/mihomo/service/*</pattern>
            <pattern>api/mihomo/subscription/*</pattern>
            <pattern>api/mihomo/status/*</pattern>
        </patterns>
    </page-services-mihomo-general>
    <page-services-mihomo-logs>
        <name>服务：Mihomo：实时日志</name>
        <patterns>
            <pattern>ui/mihomo/logs*</pattern>
            <pattern>api/mihomo/logs/*</pattern>
        </patterns>
    </page-services-mihomo-logs>
    <page-services-mihomo-rules>
        <name>服务：Mihomo：分流规则</name>
        <patterns>
            <pattern>ui/mihomo/rules*</pattern>
            <pattern>api/mihomo/rules/*</pattern>
        </patterns>
    </page-services-mihomo-rules>
    <page-services-mihomo-proxies>
        <name>服务：Mihomo：策略组</name>
        <patterns>
            <pattern>ui/mihomo/proxies*</pattern>
            <pattern>api/mihomo/proxies/*</pattern>
            <pattern>api/mihomo/status/*</pattern>
        </patterns>
    </page-services-mihomo-proxies>
    <page-services-mihomo-subscription>
        <name>服务：Mihomo：订阅管理</name>
        <patterns>
            <pattern>api/mihomo/subscription/*</pattern>
        </patterns>
    </page-services-mihomo-subscription>
    <page-services-mihomo-service>
        <name>服务：Mihomo：服务控制</name>
        <patterns>
            <pattern>api/mihomo/service/*</pattern>
        </patterns>
    </page-services-mihomo-service>
</acl>
